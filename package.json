{
  "name": "adminlte-vue-workspace",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r --filter './packages/*' run build",
    "build:demo": "pnpm --filter demo run build",
    "dev:demo": "pnpm --filter demo run dev",
    "build:docs": "pnpm --filter adminlte-docs run build",
    "dev:docs": "pnpm --filter adminlte-docs run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "pnpm -r run type-check",
    "test": "pnpm --filter @adminlte/vue test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=3": "^5.0.9",
      "js-yaml@4": "^4.3.1",
      "ws@8": "^8.21.3",
      "socket.io-parser@4": "^4.2.7",
      "glob@>=9 <14.0.2": "^14.0.2",
      "minimatch@>=7 <11.0.1": "^11.0.8"
    }
  }
}
