{
  "name": "@adminlte/nuxt",
  "version": "0.7.1",
  "description": "Nuxt module for @adminlte/vue \u2014 auto-imports, CSS, Bootstrap init, and SSR-safe theming",
  "license": "MIT",
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "nuxt",
    "nuxt-module",
    "adminlte",
    "vue",
    "bootstrap",
    "dashboard"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build build --stub",
    "prepare": "nuxt-module-build prepare",
    "type-check": "echo 'type-check: skipped for module'",
    "lint": "echo 'linting @adminlte/nuxt...'"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "@adminlte/vue": "workspace:*",
    "defu": "^6.1.4"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.0"
  },
  "peerDependenciesMeta": {
    "bootstrap": {
      "optional": true
    }
  }
}
