{
  "name": "@adminlte/vue",
  "version": "0.8.1",
  "description": "AdminLTE 4 Vue 3 component library",
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins.js"
    },
    "./css": "./dist/css/adminlte.css",
    "./css/rtl": "./dist/css/adminlte.rtl.css",
    "./css/colors": "./dist/css/adminlte-colors.css",
    "./css/colors/v3": "./dist/css/adminlte-colors-v3.css",
    "./css/docs": "./dist/css/adminlte-docs.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/css/*.css",
    "*.vue"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ColorlibHQ/adminlte-vue"
  },
  "keywords": [
    "admin",
    "dashboard",
    "template",
    "vue",
    "vue3",
    "nuxt",
    "bootstrap",
    "components",
    "adminlte"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'linting adminlte-vue...'"
  },
  "peerDependencies": {
    "@fullcalendar/core": "^6.0.0",
    "@fullcalendar/daygrid": "^6.0.0",
